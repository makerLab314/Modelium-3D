# Modelium 3D configuration.
#
# Copy this file to `.env` in the same folder, or just start the server and fill
# the fields in via Settings in the web interface — it writes back to `.env`.
#
# Every value here is optional. Without any of them Printables and MakerWorld
# still work; only Thingiverse needs a key.

# --- Sources -----------------------------------------------------------------

# Thingiverse rejects unauthenticated API calls. A token is free: create a
# "Desktop" app at https://www.thingiverse.com/apps/create and copy the App Token.
THINGIVERSE_TOKEN=

# --- Server ------------------------------------------------------------------

# HOST=127.0.0.1
# PORT=8787

# --- Search behaviour --------------------------------------------------------

# Results requested per site, per page.
# PER_SOURCE_LIMIT=36

# Give up on a site after this many milliseconds.
# SOURCE_TIMEOUT_MS=12000

# How long a successful search stays in the in-memory cache.
# CACHE_TTL_MS=300000
# CACHE_MAX_ENTRIES=200

# Serve result images through the local server instead of hotlinking the CDNs.
# PROXY_IMAGES=true

# Drop models a site flagged as not safe for work.
# HIDE_NSFW=true
