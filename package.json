{
  "name": "modelium-3d",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "One search box for Printables, Thingiverse and MakerWorld.",
  "scripts": {
    "start": "node --max-http-header-size=65536 server/index.js",
    "dev": "node --max-http-header-size=65536 --watch server/index.js",
    "test": "node --max-http-header-size=65536 --test \"test/**/*.test.js\"",
    "test:live": "node --max-http-header-size=65536 --test \"test/live/**/*.test.js\""
  },
  "engines": {
    "node": ">=20"
  },
  "license": "GPL-3.0"
}
